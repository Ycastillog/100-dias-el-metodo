{
  "name": "100-dias-el-metodo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8790 --strictPort",
    "dev:prelaunch": "vite --mode prelaunch --host 127.0.0.1 --port 8790 --strictPort",
    "build": "vite build && node hosting/stage-assets.mjs",
    "build:prelaunch": "vite build --mode prelaunch && node hosting/stage-assets.mjs --prelaunch",
    "db:generate": "drizzle-kit generate",
    "test": "node --test hosting/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "drizzle-kit": "0.31.10",
    "vite": "8.2.2"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  }
}
